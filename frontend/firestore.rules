rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Packing lists: anyone can read (public shareable links),
    // only authenticated users can write
    match /packing_lists/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Vehicles: public read for vendor dashboard, authenticated write
    match /vehicles/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Vehicle driver details: public read+write so vendors can fill in driver info
    match /vehicle_driver_details/{docId} {
      allow read, write: if true;
    }

    // Snapshots: public read (vendor links), auth write (admin creates)
    match /vehicle_snapshots/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /stay_snapshots/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Batch lead info: public read (for lead view link), auth write (admin)
    match /batch_lead_info/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tournament: fully public (no auth on organizer/captain pages, not sensitive)
    match /tournament_submissions/{docId} {
      allow read, write: if true;
    }
    match /tournament_teams/{docId} {
      allow read, write: if true;
    }

    // All other collections require authentication
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
